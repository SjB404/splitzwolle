# copy to .env.local and paste a key from https://console.cloud.google.com/google/maps-apis
# the key needs "Maps JavaScript API"; without a key every map is replaced by a panel that says so, and the rest of the app is unaffected
VITE_GOOGLE_MAPS_API_KEY=

# optional: set to true after enabling "Maps Static API" for the key, to replace the drawn previews with real map pictures
VITE_GOOGLE_MAPS_STATIC_MAPS=

# recommended: a cloud map id (Map Management > Map styles, then a JavaScript map id using it)
# without it the api's own DEMO_MAP_ID is used: unstyled, and on a demo tier whose daily cap a day of map loads runs into
VITE_GOOGLE_MAPS_MAP_ID=

# the "Routes API" is a switch on the key too; without it the planner draws its own estimate instead of real street routes
