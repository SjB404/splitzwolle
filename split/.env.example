# copy to .env.local and paste a key from https://console.cloud.google.com/google/maps-apis
# what it may cost, and the free caps: docs/maps-costs.md
# needs "Maps JavaScript API"; without a key every map is replaced by a fallback panel
VITE_GOOGLE_MAPS_API_KEY=

# optional: enable "Maps Static API" on the key, then set true to use real map pictures for the previews
VITE_GOOGLE_MAPS_STATIC_MAPS=

# recommended: a cloud map id (Map Management > Map styles, then a JavaScript map id using it)
# without it the api falls back to DEMO_MAP_ID, which is unstyled and capped per day
VITE_GOOGLE_MAPS_MAP_ID=

# needs "Routes API" on the key too; without it the planner draws its own estimate instead of street routes

# --- backend (split/backend) ---
# mysql server the api connects to; these are the development defaults
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=swolla

# signs the auth tokens; in production the server refuses to start without a real value
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1h

# google oauth client; leave empty to disable "sign in with google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# where the api sends the browser after login, and the only origin cors allows
FRONTEND_URL=http://localhost:5173

# port the api listens on
PORT=3000
